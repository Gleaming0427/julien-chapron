---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import AppCard from "../components/AppCard.astro";
import { apps } from "../data/cv";
---

<Layout
  title="Apps & outils — Julien Chapron"
  description="Les applications et outils de Julien Chapron : Pims Pocket, lecture de plateau de jeu par vision IA, api-gateway-core, cve-triage."
>
  <header class="page-head reveal">
    <h1><span class="prompt">$</span> ls ~/apps</h1>
    <p class="sub">Galerie des applications et outils que j'ai conçus et développés.</p>
  </header>

  <Section command="find . -name '*.app'" index="01">
    <div class="apps-list">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </Section>
</Layout>
