---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import RepoCard from "../components/RepoCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import repos from "../data/repos.json";
import { personalProjects } from "../data/cv";

// Le repo du site lui-même n'apparaît pas dans la liste.
const ownRepos = repos.filter((repo) => repo.name !== "julien-chapron");
---

<Layout
  title="Projets — Julien Chapron"
  description="Repositories GitHub et projets personnels de Julien Chapron : api-gateway-core, cve-agent, Pims Pocket, lecture de plateau de jeu par vision IA…"
>
  <header class="page-head reveal">
    <h1><span class="prompt">$</span> ls ~/github</h1>
    <p class="sub">Repositories publics et projets personnels, données GitHub synchronisées par <code>npm run fetch-repos</code>.</p>
  </header>

  <Section command="git remote -v">
    <div class="cards">
      {ownRepos.map((repo) => <RepoCard repo={repo} />)}
    </div>
  </Section>

  <Section command="ls ~/projets-personnels">
    <div class="cards">
      {personalProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>
</Layout>
