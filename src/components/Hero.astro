---
import type { Locale } from "../data/cv";
import { cv } from "../data/cv";

const locale = (Astro.currentLocale ?? "fr") as Locale;
const { identity, ui } = cv[locale];

const base = import.meta.env.BASE_URL;
const pdfUrl = base === "/" ? "/CV_Julien_Chapron.pdf" : `${base}/CV_Julien_Chapron.pdf`;
const portraitUrl = base === "/" ? "/julien-chapron.webp" : `${base}/julien-chapron.webp`;

---

<section class="hero">
  <!-- Plain header kept for printing the CV. Le nom y est un paragraphe et
       non un <h1> : masqué à l'écran, il restait dans le DOM, et la page
       avait donc DEUX <h1> portant le même texte. La feuille d'impression
       lui garde son allure de titre. -->
  <div class="print-only">
    <p class="print-nom">{identity.name}</p>
    <p class="print-role">{identity.role}</p>
    <p class="print-contact">
      {identity.location} · {identity.phone} · {identity.email} · {identity.githubLabel}
    </p>
  </div>

  <!-- Editorial title on the left, dedicated 3D scene on the right. -->
  <div class="hero-top">
    <div class="hero-col">
      <div class="hero-title">
        {/* Le nom porte le <h1>, et non le rôle : la page parle d'une
            personne, et c'est le nom qu'on tape dans un moteur. The greeting
            comes back: it reads like an introduction, and the name keeps its
            orange. */}
        <h1 class="hero-overline">{ui.heroOverlinePre}<span class="hero-overline-nom">{identity.name}</span></h1>
        <p class="hero-role">{ui.rolePre}<em>{ui.roleEm}</em>{ui.roleFin}</p>
        {/* La ligne porte directement les phrases qui défilent : la mention de
            disponibilité qui l'ouvrait a été retirée. Ce texte-ci n'est que le
            premier de ui.sousTitres — il est écrit ici pour que la
            page ait quelque chose à montrer avant que le script ne prenne la
            main, et les deux viennent de la même source. */}
        <p class="hero-sub">{ui.sousTitres[0]}</p>
        <div class="hero-actions">
          <a class="axiom-btn" href={pdfUrl} download="CV_Julien_Chapron.pdf">
            <span class="axiom-btn-text-col">
              <span class="axiom-btn-text-row">{ui.boutonCV}</span>
              <span class="axiom-btn-text-row" aria-hidden="true">{ui.boutonCV}</span>
            </span>
            <span class="axiom-btn-arrow-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h17.4" /><path d="m15.2 6.8 5.2 5.2-5.2 5.2" /></svg>
            </span>
          </a>
          <a class="axiom-btn axiom-btn-ghost" href={`mailto:${identity.email}`}>
            <span class="axiom-btn-text-col">
              <span class="axiom-btn-text-row">{ui.boutonContact}</span>
              <span class="axiom-btn-text-row" aria-hidden="true">{ui.boutonContact}</span>
            </span>
            <span class="axiom-btn-arrow-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h17.4" /><path d="m15.2 6.8 5.2 5.2-5.2 5.2" /></svg>
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero-stage" aria-hidden="true">
      <!-- Une scène ancrée, et non plus une pastille flottante reliée par un
           fil. Le tout est accroché à Toulouse : hero3d.ts écrit la position
           projetée de la ville dans --ville-x / --ville-y, et l'ensemble suit
           le globe puis s'efface quand la ville passe derrière.

           L'ordre raconte : une balise vivante sur la ville, son nom, puis la
           carte qui dit qui y habite et qu'il est disponible. -->
      <div class="hero-ancre">
        <span class="hero-balise"></span>
        <span class="hero-ville">Toulouse</span>

        <div class="hero-carte">
          <img
            class="hero-portrait"
            src={portraitUrl}
            width="56"
            height="56"
            alt=""
            decoding="async"
          />
          <span class="hero-carte-texte">
            <b class="hero-carte-nom">{identity.name}</b>
            <!-- Plus de pastille pulsante ici : la balise sur Toulouse est le
                 seul point de la scène, et un second à dix pixels de la photo
                 lui disputait le regard. Le mot « maintenant » suffit. -->
            <span class="hero-carte-dispo">{ui.carteDispo}</span>
          </span>
        </div>
      </div>
    </div>
  </div>

</section>
