---
interface Repo {
  name: string;
  description: string;
  language: string | null;
  homepage: string | null;
  html_url: string;
  stargazers_count: number;
  pushed_at: string;
}

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;

// Couleurs GitHub pour les langages les plus courants.
const langColors: Record<string, string> = {
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Python: "#3572a5",
  Astro: "#ff5a03",
  PHP: "#4f5d95",
  HTML: "#e34c26",
  CSS: "#563d7c",
  Go: "#00add8",
  Rust: "#dea584",
  Shell: "#89e051",
};

const date = new Date(repo.pushed_at);
const pushed = new Intl.DateTimeFormat("fr-FR", { year: "numeric", month: "short" }).format(date);
---

<article class="card">
  <div class="card-head">
    <h3><a href={repo.html_url} target="_blank" rel="noopener noreferrer">{repo.name}</a></h3>
    {repo.homepage && <span class="badge online">en ligne</span>}
  </div>
  <p>{repo.description || "Pas de description."}</p>
  <div class="repo-meta">
    {repo.language && (
      <span>
        <span class="lang-dot" style={`background: ${langColors[repo.language] ?? "#8b949e"}`}></span>
        {repo.language}
      </span>
    )}
    <span>★ {repo.stargazers_count}</span>
    <span>mis à jour : {pushed}</span>
  </div>
  <div class="card-links">
    <a href={repo.html_url} target="_blank" rel="noopener noreferrer">↗ code</a>
    {repo.homepage && (
      <a href={repo.homepage} target="_blank" rel="noopener noreferrer">↗ démo</a>
    )}
  </div>
</article>
