---
interface Props {
  /** Texts that scroll, separated by a green prompt. */
  items: string[];
  /** Scroll direction: left (default) or right. */
  direction?: "left" | "right";
  /** mono (default): tech stack · display: large editorial figures. */
  variant?: "mono" | "display";
  /** Sticks to the bottom edge (for the band just above the tear). */
  tightBottom?: boolean;
}

const { items, direction = "left", variant = "mono", tightBottom = false } = Astro.props;

// Static content (no user input): the set:html is safe.
// Every other item is outlined, in the style of editorial typography.
const half = items
  .map(
    (item, index) =>
      `<span class="marquee-item${index % 2 === 1 ? " outline" : ""}">${item}</span>` +
      `<span class="marquee-sep" aria-hidden="true">$</span>`,
  )
  .join("");
---

<div
  class:list={[
    "marquee",
    direction === "right" && "marquee-right",
    variant === "display" && "marquee-display",
    tightBottom && "marquee-tight-bottom",
  ]}
  aria-hidden="true"
>
  <div class="marquee-track">
    <span class="marquee-half" set:html={half}></span>
    <span class="marquee-half" set:html={half}></span>
  </div>
</div>
