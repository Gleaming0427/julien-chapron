---
interface Props {
  /** Textes qui défilent, séparés par un prompt vert. */
  items: string[];
  /** Sens du défilement : left (défaut) ou right. */
  direction?: "left" | "right";
  /** mono (défaut) : stack technique · display : grands chiffres éditoriaux. */
  variant?: "mono" | "display";
  /** Colle le bord inférieur (pour le bandeau juste au-dessus de la déchirure). */
  tightBottom?: boolean;
}

const { items, direction = "left", variant = "mono", tightBottom = false } = Astro.props;

// Contenu statique (pas d'entrée utilisateur) : le set:html est sans risque.
// Un item sur deux est en contour (outline), façon typographie éditoriale.
const half = items
  .map(
    (item, index) =>
      `<span class="marquee-item${index % 2 === 1 ? " outline" : ""}">${item}</span>` +
      `<span class="marquee-sep" aria-hidden="true">$</span>`,
  )
  .join("");
---

<div
  class:list={[
    "marquee",
    direction === "right" && "marquee-right",
    variant === "display" && "marquee-display",
    tightBottom && "marquee-tight-bottom",
  ]}
  aria-hidden="true"
>
  <div class="marquee-track">
    <span class="marquee-half" set:html={half}></span>
    <span class="marquee-half" set:html={half}></span>
  </div>
</div>
