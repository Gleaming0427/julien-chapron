---
import type { App } from "../data/cv";

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<article class="card app-card">
  <div class="app-emoji" aria-hidden="true">{app.emoji}</div>
  <div class="app-body">
    <div class="card-head">
      <h3>{app.name}</h3>
      <span class:list={["badge", { online: app.status === "en ligne" }, { oss: app.status === "open source" || app.status === "open source · MIT" }]}>
        {app.status}
      </span>
    </div>
    <p class="app-type">{app.type}</p>
    <p>{app.description}</p>
    <div class="stack">⚙ {app.stack}</div>
    {
      app.links.length > 0 && (
        <div class="card-links">
          {app.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">↗ {link.label}</a>
          ))}
        </div>
      )
    }
  </div>
</article>
