---
interface Props {
  /** Command displayed in the title, terminal style. */
  command: string;
  /** Extra class(es), merged onto the section. */
  class?: string;
}

const { command, class: extraClass } = Astro.props;
---

<section class:list={["section", extraClass]}>
  <!-- La commande est un ornement, pas un intitulé. En <h2> elle occupait le
       plan du document à la place des vrais titres : Google lisait « $ cat
       profil.md », « $ experience --all », « $ ls ~/projets-personnels » là
       où se trouvent les mots du métier. Les intitulés qui les portent sont
       remontés en <h2> dans la page. -->
  <p class="section-title" aria-hidden="true">
    <span class="prompt">$</span> <span class="cmd">{command}</span>
  </p>
  <slot />
</section>
