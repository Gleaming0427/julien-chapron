---
interface Props {
  /** Commande affichée dans le titre, façon terminal. */
  command: string;
  /** Classe(s) supplémentaires, fusionnées sur la section. */
  class?: string;
}

const { command, class: extraClass } = Astro.props;
---

<section class:list={["section", extraClass]}>
  <h2 class="section-title">
    <span class="prompt">$</span> <span class="cmd">{command}</span>
  </h2>
  <slot />
</section>
