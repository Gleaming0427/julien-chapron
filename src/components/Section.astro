---
interface Props {
  /** Command displayed in the title, terminal style. */
  command: string;
  /** Extra class(es), merged onto the section. */
  class?: string;
}

const { command, class: extraClass } = Astro.props;
---

<section class:list={["section", extraClass]}>
  <h2 class="section-title">
    <span class="prompt">$</span> <span class="cmd">{command}</span>
  </h2>
  <slot />
</section>
