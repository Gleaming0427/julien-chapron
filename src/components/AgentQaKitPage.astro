---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import type { Locale } from "../data/cv";

interface Props { locale: Locale }
const { locale } = Astro.props;
const path = "/agent-qa-kit/";
const home = getRelativeLocaleUrl(locale, "/");

const copy = {
  fr: {
    metaTitle: "Agent QA Kit · Étude de cas — Julien Chapron",
    metaDescription: "Une étape QA indépendante pour le code écrit par des agents IA : tests avant le code, vérification en lecture seule et évaluation sur 16 tickets.",
    back: "Retour au portfolio",
    category: "Projet open source / Étude de cas",
    badge: "Expérimental · 2026",
    title: "Prouver que le code IA fonctionne.",
    lead: "Agent QA Kit ajoute une preuve indépendante entre le code écrit par un agent et son acceptation : des tests définis avant le code, validés par une personne, puis rejoués dans un vrai navigateur.",
    source: "Voir le code source",
    explore: "Explorer la méthode",
    heroAside: "Le principe",
    heroAsideText: "La réussite n'est déclarée que si les tests gelés passent et que les rapports réels confirment le verdict de l'agent vérificateur.",
    problemLabel: "01 / Le problème",
    problemTitle: "Une revue de code ne voit pas l'écran.",
    problemLead: "Quand une IA écrit une fonctionnalité, une autre IA peut relire le diff. Cela ne démontre pas que le parcours demandé fonctionne pour l'utilisateur.",
    problemItems: [
      { n: "01", title: "Auto-évaluation", text: "L'agent qui code juge facilement son propre travail." },
      { n: "02", title: "Diff incomplet", text: "Un bouton disparu sur mobile peut sembler anodin dans une revue de code." },
      { n: "03", title: "Tests après coup", text: "Des tests écrits après l'implémentation risquent d'entériner le bug." },
    ],
    flowLabel: "02 / Le déroulé",
    flowTitle: "Des attentes figées avant le premier commit.",
    flowLead: "Chaque critère d'acceptation devient un contrôle vérifiable. Une personne approuve les tests une seule fois ; les agents suivants ne peuvent plus les réécrire.",
    flow: [
      { no: "01", title: "Ticket", text: "Critères d'acceptation et comportement attendu." },
      { no: "02", title: "Tests", text: "Vitest et Playwright, d'abord rouges pour la bonne raison." },
      { no: "03", title: "Validation", text: "Relecture humaine, gel des tests et contrôle de leurs empreintes." },
      { no: "04", title: "Développement", text: "L'agent implémente la fonctionnalité sous permissions limitées." },
      { no: "05", title: "Vérification", text: "Agent sans droit d'écriture ; verdict recoupé avec les rapports réels." },
    ],
    repairLabel: "Si ça échoue",
    repairText: "Un agent de réparation corrige l'application, jamais les tests. Deux tentatives au maximum.",
    guardLabel: "Garde-fous",
    guardText: "Les commandes des agents tournent dans un sandbox sans réseau ni clé API. Un hook refuse les actions hors du rôle attribué à chaque agent.",
    measureLabel: "03 / L'évaluation",
    measureTitle: "Mesurer les agents comme un modèle.",
    measureLead: "Le kit est évalué sur 16 tickets de la boutique de démonstration : implémentations de référence, bugs injectés et tests cachés. Chaque essai utilise un runner neuf ; le corpus est déplacé hors de l'espace de travail de l'agent.",
    measurePoints: [
      { n: "16", label: "tickets dans le corpus" },
      { n: "48", label: "essais dans la campagne propre" },
      { n: "3", label: "essais par ticket" },
    ],
    methodTitle: "Une décision définie avant les résultats",
    methodText: "Les rapports donnent des intervalles de Wilson à 95 % et une erreur standard regroupée par ticket. Les règles de release sont fixées avant les résultats ; les campagnes anciennes sont recoupées avec leurs transcriptions. Des essais de contrôle et un plafond de dépense gardent les coûts sous contrôle.",
    resultsLabel: "04 / Ce que les mesures montrent",
    resultsTitle: "Un résultat solide. Une limite révélatrice.",
    baselineLabel: "Version D · campagne propre du 3 novembre 2026",
    metrics: [
      { value: "45/48", label: "essais réussis" },
      { value: "86/87", label: "bugs injectés détectés" },
      { value: "0,11 $", label: "environ par essai" },
    ],
    tableCaption: "Détail des 48 essais",
    tableHead: ["Tickets", "Essais réussis", "Bugs détectés"],
    tableRows: [
      ["EVAL-11 à EVAL-16", "18/18", "36/36"],
      ["EVAL-1 à EVAL-10", "27/30", "50/51"],
    ],
    insightTitle: "Le cas du code promo",
    insightText: "Dans les deux campagnes pilotes, les tests ont manqué six fois sur six le bug qui incluait la livraison dans la remise : leur panier bénéficiait déjà de la livraison gratuite. Même dans la campagne propre, EVAL-1 compte encore un bug manqué et un faux positif sur trois essais. La mesure rend ces limites visibles.",
    reportLabel: "Lire le rapport de campagne",
    closeLabel: "05 / Ce que j'en retiens",
    closeTitle: "Des garanties vérifiables, avec leurs limites.",
    closeText: "Ce projet démontre une conception d'agents à permissions minimales, des vérifications déterministes et une évaluation statistique prudente. Il reste expérimental : le corpus est une petite boutique en ligne de démonstration, pas encore des tickets de projets réels.",
    credit: "Conçu et piloté par moi, développé avec Claude Code.",
    stackLabel: "Stack",
    stack: "Claude Code · TypeScript / Node.js 22 · Playwright · Vitest · React · GitHub Actions · bubblewrap",
    homeLink: "Retour aux projets",
    languageLabel: "Langue",
  },
  en: {
    metaTitle: "Agent QA Kit · Case study — Julien Chapron",
    metaDescription: "Independent QA for AI-written code: tests before implementation, read-only verification and evaluation across 16 tickets.",
    back: "Back to portfolio",
    category: "Open-source project / Case study",
    badge: "Experimental · 2026",
    title: "Prove AI-written code works.",
    lead: "Agent QA Kit adds independent evidence between an agent's code and its acceptance: tests defined before implementation, approved by a person, then rerun in a real browser.",
    source: "View source code",
    explore: "Explore the method",
    heroAside: "The principle",
    heroAsideText: "Success is declared only when the frozen tests pass and real test reports confirm the verifier agent's verdict.",
    problemLabel: "01 / The problem",
    problemTitle: "A code review cannot see the screen.",
    problemLead: "When one AI writes a feature, another can review the diff. That does not prove the requested journey works for the user.",
    problemItems: [
      { n: "01", title: "Self-assessment", text: "The coding agent is likely to judge its own work." },
      { n: "02", title: "Incomplete diff", text: "A button missing on mobile can look harmless in a code review." },
      { n: "03", title: "Tests after the fact", text: "Tests written after implementation can preserve the bug." },
    ],
    flowLabel: "02 / The workflow",
    flowTitle: "Expectations frozen before the first commit.",
    flowLead: "Every acceptance criterion becomes a verifiable check. A person approves the tests once; later agents cannot rewrite them.",
    flow: [
      { no: "01", title: "Ticket", text: "Acceptance criteria and expected behaviour." },
      { no: "02", title: "Tests", text: "Vitest and Playwright, failing first for the right reason." },
      { no: "03", title: "Approval", text: "Human review, frozen tests and fingerprint checks." },
      { no: "04", title: "Development", text: "The agent builds the feature with limited permissions." },
      { no: "05", title: "Verification", text: "Read-only agent; verdict checked against real reports." },
    ],
    repairLabel: "If it fails",
    repairText: "A repair agent changes the application, never the tests. Two attempts at most.",
    guardLabel: "Guardrails",
    guardText: "Agent commands run in a sandbox without network access or an API key. A hook rejects actions outside each agent's role.",
    measureLabel: "03 / Evaluation",
    measureTitle: "Measure agents like a model.",
    measureLead: "The kit is evaluated on 16 demo-shop tickets: reference implementations, injected bugs and hidden tests. Each trial uses a fresh runner; the corpus is moved out of the agent's workspace.",
    measurePoints: [
      { n: "16", label: "tickets in the corpus" },
      { n: "48", label: "trials in the clean campaign" },
      { n: "3", label: "trials per ticket" },
    ],
    methodTitle: "A decision set before the results",
    methodText: "The reports give 95% Wilson intervals and standard errors clustered by ticket. Release rules are set before the results; earlier campaigns are rechecked against their transcripts. Control trials and a campaign spending cap keep costs in check.",
    resultsLabel: "04 / What the measurements show",
    resultsTitle: "A strong result. A revealing weakness.",
    baselineLabel: "Version D · clean campaign, 3 November 2026",
    metrics: [
      { value: "45/48", label: "successful trials" },
      { value: "86/87", label: "injected bugs detected" },
      { value: "$0.11", label: "approximately per trial" },
    ],
    tableCaption: "Breakdown of the 48 trials",
    tableHead: ["Tickets", "Successful trials", "Bugs detected"],
    tableRows: [
      ["EVAL-11 to EVAL-16", "18/18", "36/36"],
      ["EVAL-1 to EVAL-10", "27/30", "50/51"],
    ],
    insightTitle: "The promo-code case",
    insightText: "Across the two pilot campaigns, the tests missed the bug that included shipping in the discount in all six trials: their basket already had free shipping. Even in the clean campaign, EVAL-1 still has one missed bug and one false positive across three trials. Measurement makes these limits visible.",
    reportLabel: "Read the campaign report",
    closeLabel: "05 / What it demonstrates",
    closeTitle: "Verifiable safeguards, with clear limits.",
    closeText: "This project demonstrates least-privilege agents, deterministic checks and cautious statistical evaluation. It remains experimental: the corpus is a small demo shop, not real project tickets yet.",
    credit: "Designed and directed by me, developed with Claude Code.",
    stackLabel: "Stack",
    stack: "Claude Code · TypeScript / Node.js 22 · Playwright · Vitest · React · GitHub Actions · bubblewrap",
    homeLink: "Back to projects",
    languageLabel: "Language",
  },
};
const t = copy[locale];
---

<Layout title={t.metaTitle} description={t.metaDescription}>
  <div class="qa-page">
    <header class="qa-nav qa-wrap">
      <a class="qa-back" href={`${home}#projets`}><span aria-hidden="true">←</span> {t.back}</a>
      <div class="qa-nav-right">
        <span class="qa-nav-mark">JULIEN CHAPRON / 01</span>
        <nav aria-label={t.languageLabel} class="qa-languages">
          <a href={getRelativeLocaleUrl("fr", path)} hreflang="fr" aria-current={locale === "fr" ? "page" : undefined}>FR</a>
          <span aria-hidden="true">/</span>
          <a href={getRelativeLocaleUrl("en", path)} hreflang="en" aria-current={locale === "en" ? "page" : undefined}>EN</a>
        </nav>
      </div>
    </header>

    <section class="qa-hero qa-wrap" aria-labelledby="qa-title">
      <div class="qa-kicker"><span class="qa-dot"></span>{t.category}<span class="qa-kicker-end">{t.badge}</span></div>
      <div class="qa-hero-grid">
        <div>
          <p class="qa-wordmark">AGENT QA KIT<span class="qa-wordmark-caret">_</span></p>
          <h1 id="qa-title">{t.title}</h1>
          <p class="qa-lead">{t.lead}</p>
          <div class="qa-actions">
            <a class="qa-button" href="#methode">{t.explore} <span aria-hidden="true">↘</span></a>
            <a class="qa-text-link" href="https://github.com/Gleaming0427/agent-qa-kit" target="_blank" rel="noopener noreferrer">{t.source} ↗</a>
          </div>
        </div>
        <aside class="qa-hero-note">
          <span class="qa-note-head">{t.heroAside}</span>
          <div class="qa-signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          <p>{t.heroAsideText}</p>
          <span class="qa-note-foot">TESTS ✓ &nbsp; RAPPORTS ✓ &nbsp; VERDICT ✓</span>
        </aside>
      </div>
      <div class="qa-hero-index"><span>QA / 001</span><span>SCROLL ↓</span></div>
    </section>

    <section class="qa-section qa-wrap" aria-labelledby="probleme-title">
      <div class="qa-section-intro">
        <p class="qa-section-label">{t.problemLabel}</p>
        <div><h2 id="probleme-title">{t.problemTitle}</h2><p class="qa-section-lead">{t.problemLead}</p></div>
      </div>
      <div class="qa-problem-grid">
        {t.problemItems.map((item) => <article class="qa-problem"><span>{item.n} /</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </section>

    <section class="qa-section qa-flow-section qa-wrap" id="methode" aria-labelledby="methode-title">
      <div class="qa-section-intro">
        <p class="qa-section-label">{t.flowLabel}</p>
        <div><h2 id="methode-title">{t.flowTitle}</h2><p class="qa-section-lead">{t.flowLead}</p></div>
      </div>
      <ol class="qa-flow" aria-label={t.flowTitle}>
        {t.flow.map((step) => <li><div class="qa-flow-top"><span>{step.no}</span><span class="qa-flow-arrow" aria-hidden="true">→</span></div><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
      <div class="qa-flow-notes">
        <div><span class="qa-note-icon" aria-hidden="true">↻</span><div><h3>{t.repairLabel}</h3><p>{t.repairText}</p></div></div>
        <div><span class="qa-note-icon" aria-hidden="true">⌁</span><div><h3>{t.guardLabel}</h3><p>{t.guardText}</p></div></div>
      </div>
    </section>

    <section class="qa-measure" aria-labelledby="mesure-title">
      <div class="qa-wrap qa-measure-inner">
        <div class="qa-section-intro">
          <p class="qa-section-label">{t.measureLabel}</p>
          <div><h2 id="mesure-title">{t.measureTitle}</h2><p class="qa-section-lead">{t.measureLead}</p></div>
        </div>
        <div class="qa-measure-bottom">
          <div class="qa-measure-stats">{t.measurePoints.map((point) => <div><strong>{point.n}</strong><span>{point.label}</span></div>)}</div>
          <div class="qa-measure-method"><h3>{t.methodTitle}</h3><p>{t.methodText}</p></div>
        </div>
      </div>
    </section>

    <section class="qa-section qa-results qa-wrap" aria-labelledby="resultats-title">
      <div class="qa-section-intro">
        <p class="qa-section-label">{t.resultsLabel}</p>
        <div><h2 id="resultats-title">{t.resultsTitle}</h2></div>
      </div>
      <p class="qa-results-subtitle">{t.baselineLabel}</p>
      <div class="qa-metric-grid">{t.metrics.map((metric) => <div class="qa-metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
      <a class="qa-report-link" href="https://github.com/Gleaming0427/agent-qa-kit/blob/main/eval/results/2026-11-03-clean-campaign.md" target="_blank" rel="noopener noreferrer">{t.reportLabel} ↗</a>
      <div class="qa-result-comparison">
        <div class="qa-table-wrap">
          <table><caption>{t.tableCaption}</caption><thead><tr>{t.tableHead.map((head) => <th scope="col">{head}</th>)}</tr></thead><tbody>{t.tableRows.map((row) => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table>
        </div>
        <aside class="qa-insight"><span class="qa-insight-mark" aria-hidden="true">!</span><h3>{t.insightTitle}</h3><p>{t.insightText}</p></aside>
      </div>
    </section>

    <section class="qa-end" aria-labelledby="fin-title">
      <div class="qa-wrap qa-end-inner">
        <p class="qa-section-label">{t.closeLabel}</p>
        <h2 id="fin-title">{t.closeTitle}</h2>
        <p class="qa-end-text">{t.closeText}</p>
        <p class="qa-credit">{t.credit}</p>
        <div class="qa-end-footer"><div><span>{t.stackLabel}</span><p>{t.stack}</p></div><div class="qa-end-links"><a href="https://github.com/Gleaming0427/agent-qa-kit" target="_blank" rel="noopener noreferrer">{t.source} ↗</a><a href={`${home}#projets`}>{t.homeLink} ↑</a></div></div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .qa-page { --qa-orange: #ff4d00; --qa-ink: #0b0c0d; --qa-paper: #f3f1ec; --qa-muted: #a2a4a5; color: var(--qa-paper); background: var(--qa-ink); margin: calc(-1 * var(--header-h)) calc(-1 * var(--gutter)) calc(-1 * var(--pied-bas)); font-family: var(--font-sans); }
  .qa-wrap { width: min(100% - 2 * var(--gutter), 1380px); margin-inline: auto; }
  .qa-nav { min-height: 82px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid #343637; }
  .qa-back, .qa-languages a, .qa-text-link, .qa-end-links a { color: inherit; text-decoration: none; }
  .qa-back { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; }
  .qa-back span { color: var(--qa-orange); font-size: 23px; line-height: 1; }
  .qa-nav-right { display: flex; align-items: center; gap: clamp(18px, 4vw, 60px); }
  .qa-nav-mark, .qa-languages, .qa-kicker, .qa-hero-index, .qa-note-head, .qa-note-foot, .qa-section-label, .qa-results-subtitle, .qa-credit, .qa-end-footer span { font-family: "IBM Plex Mono", monospace; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .qa-nav-mark { color: #888e90; }
  .qa-languages { display: flex; gap: 10px; align-items: center; }
  .qa-languages a { color: #85898b; }
  .qa-languages a[aria-current] { color: var(--qa-paper); }
  a:hover, a:focus-visible { color: #ff9b70; }
  a:focus-visible { outline: 2px solid var(--qa-orange); outline-offset: 5px; }
  .qa-hero { min-height: min(820px, calc(100svh - 82px)); display: flex; flex-direction: column; justify-content: space-between; padding-block: clamp(42px, 7vh, 92px) 22px; }
  .qa-kicker { display: flex; align-items: center; gap: 13px; color: #aaaeb0; }
  .qa-dot { width: 7px; height: 7px; background: var(--qa-orange); border-radius: 50%; box-shadow: 0 0 16px #ff4d0077; }
  .qa-kicker-end { margin-left: auto; color: #ff9b70; }
  .qa-hero-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(250px, .52fr); gap: clamp(36px, 8vw, 125px); align-items: end; padding-block: 72px; }
  .qa-wordmark { margin: 0 0 14px; color: var(--qa-orange); font-family: "IBM Plex Mono", monospace; font-size: clamp(14px, 1.7vw, 22px); font-weight: 600; letter-spacing: .23em; }
  .qa-wordmark-caret { animation: qa-blink 1.1s steps(1) infinite; }
  @keyframes qa-blink { 50% { opacity: 0; } }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 1000px; margin-bottom: 30px; font-size: clamp(56px, 7.6vw, 128px); line-height: .92; font-weight: 600; letter-spacing: -.065em; }
  .qa-lead { max-width: 740px; margin-bottom: 32px; color: #b7b9ba; font-size: clamp(18px, 1.65vw, 25px); line-height: 1.45; }
  .qa-actions { display: flex; flex-wrap: wrap; gap: 18px 32px; align-items: center; }
  .qa-button { display: inline-flex; align-items: center; gap: 26px; padding: 15px 21px; background: var(--qa-orange); color: var(--qa-ink); font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 3px; }
  .qa-button:hover, .qa-button:focus-visible { background: #ff824d; color: var(--qa-ink); }
  .qa-button span { font-size: 20px; line-height: 1; }
  .qa-text-link { font-size: 14px; text-decoration: underline; text-underline-offset: 5px; }
  .qa-hero-note { border: 1px solid #414344; padding: 22px; max-width: 340px; }
  .qa-note-head { color: #ff9b70; }
  .qa-signal { display: flex; align-items: end; height: 76px; gap: 7px; margin: 28px 0 18px; }
  .qa-signal i { display: block; flex: 1; height: 28%; border: 1px solid var(--qa-orange); background: #ff4d0026; }
  .qa-signal i:nth-child(2) { height: 56%; }.qa-signal i:nth-child(3) { height: 37%; }.qa-signal i:nth-child(4) { height: 80%; }.qa-signal i:nth-child(5) { height: 100%; background: var(--qa-orange); }
  .qa-hero-note p { color: #c6c6c4; font-size: 15px; line-height: 1.55; }
  .qa-note-foot { color: #888e90; font-size: 10px; letter-spacing: .01em; white-space: nowrap; }
  .qa-hero-index { display: flex; justify-content: space-between; border-top: 1px solid #343637; padding-top: 16px; color: #888e90; }
  .qa-section { padding-block: clamp(82px, 11vw, 160px); }
  .qa-section-intro { display: grid; grid-template-columns: minmax(160px, .38fr) minmax(0, 1fr); gap: 32px; margin-bottom: clamp(40px, 6vw, 78px); }
  .qa-section-label { color: #ff824d; margin: 8px 0 0; }
  h2 { max-width: 980px; margin-bottom: 24px; font-size: clamp(40px, 5.5vw, 86px); font-weight: 600; line-height: 1.02; letter-spacing: -.055em; }
  .qa-section-lead { max-width: 760px; margin-bottom: 0; color: #adb0b1; font-size: clamp(17px, 1.45vw, 22px); line-height: 1.55; }
  .qa-problem-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid #414344; }
  .qa-problem { min-height: 240px; padding: 26px clamp(18px, 2.5vw, 38px) 18px 0; }
  .qa-problem + .qa-problem { padding-left: clamp(18px, 2.5vw, 38px); border-left: 1px solid #414344; }
  .qa-problem > span { color: var(--qa-orange); font-family: "IBM Plex Mono", monospace; font-size: 13px; }
  .qa-problem h3 { margin: 52px 0 11px; font-size: clamp(21px, 2vw, 29px); font-weight: 600; letter-spacing: -.025em; }
  .qa-problem p { margin: 0; color: #a8abad; font-size: 16px; line-height: 1.55; }
  .qa-flow-section { padding-top: 20px; }
  .qa-flow { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border: 1px solid #505254; }
  .qa-flow li { min-width: 0; padding: 20px; min-height: 234px; }
  .qa-flow li + li { border-left: 1px solid #505254; }
  .qa-flow-top { display: flex; justify-content: space-between; color: var(--qa-orange); font-family: "IBM Plex Mono", monospace; font-size: 15px; }
  .qa-flow-arrow { color: #777; font-size: 20px; }
  .qa-flow li:last-child .qa-flow-arrow { display: none; }
  .qa-flow h3 { margin: 65px 0 8px; font-size: clamp(18px, 1.65vw, 24px); line-height: 1.1; }
  .qa-flow p { margin: 0; color: #aeb1b1; font-size: 14px; line-height: 1.45; }
  .qa-flow-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding-top: 26px; }
  .qa-flow-notes > div { display: flex; gap: 18px; align-items: start; }
  .qa-note-icon { display: grid; place-items: center; flex: 0 0 35px; height: 35px; border: 1px solid var(--qa-orange); color: var(--qa-orange); font-family: "IBM Plex Mono", monospace; font-size: 21px; }
  .qa-flow-notes h3 { margin: 0 0 4px; font-size: 17px; }.qa-flow-notes p { margin: 0; color: #aeb1b1; font-size: 14px; }
  .qa-measure { background: var(--qa-orange); color: var(--qa-ink); margin-inline: 0; }
  .qa-measure-inner { padding-block: clamp(74px, 10vw, 145px); }
  .qa-measure .qa-section-label, .qa-measure .qa-section-lead { color: #341004; }
  .qa-measure-bottom { display: grid; grid-template-columns: 1.25fr .75fr; gap: clamp(30px, 6vw, 95px); align-items: end; }
