---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import type { Locale } from "../data/cv";
import { cv } from "../data/cv";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const locale = (Astro.currentLocale ?? "fr") as Locale;
const { identity } = cv[locale];

const base = import.meta.env.BASE_URL;
// Builds an internal URL prefixed with the base (e.g. '/julien-chapron/projets').
const url = (path: string) =>
  path === "/" ? (base === "/" ? "/" : base + "/") : base === "/" ? path : base + path;

const canonical = new URL(Astro.url.pathname, Astro.site);
const partage = new URL(url("/og-julien-chapron.png"), Astro.site).href;

/* Données structurées. Sans elles, rien ne reliait explicitement « Julien
   Chapron » au métier, à la ville et aux comptes publics : le moteur devait
   le deviner du texte. Tout vient de cv.ts, il n'y a donc rien à tenir à jour
   en double. */
const ficheAuteur = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  jobTitle: identity.role,
  description:
    locale === "fr"
      ? "Développeur full-stack TypeScript, React et Node.js, sept ans en production."
      : "Full-stack TypeScript, React and Node.js developer, seven years in production.",
  url: new URL(url("/"), Astro.site).href,
  image: partage,
  email: `mailto:${identity.email}`,
  telephone: identity.phoneHref.replace("tel:", ""),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Toulouse",
    addressRegion: "Occitanie",
    addressCountry: "FR",
  },
  sameAs: [identity.github, identity.npm],
  knowsAbout: [
    "TypeScript",
    "React",
    "Node.js",
    "GraphQL",
    "Docker",
    "Kubernetes",
    "PostgreSQL",
    "CI/CD",
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c0d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Julien Chapron" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <!-- Sans image de partage, un lien envoyé sur LinkedIn, WhatsApp ou Slack
         s'affiche en carte vide. Le site n'ayant aucune image, il a fallu en
         fabriquer une : 1200 x 630, aux couleurs de la page. -->
    <meta property="og:image" content={partage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${identity.name}, ${identity.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={partage} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="sitemap" type="application/xml" href={url("/sitemap-index.xml")} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ficheAuteur)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- Marks JS as active for scroll reveals: without JS, everything stays visible. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <!-- Lien d'évitement. La page fait dix écrans : sans lui, atteindre le
         contenu au clavier passait par toute l'en-tête à chaque visite.
         Invisible tant qu'il n'a pas le focus. -->
    <a class="saut-contenu" href={getRelativeLocaleUrl(locale, "/") + "#main"}>{locale === "fr" ? "Aller au contenu" : "Skip to content"}</a>

    <!-- Rappel d'orientation : affiché uniquement sur écran tactile tenu à
         l'horizontale. Le site est construit sur des blocs d'un écran de
         haut ; couché, un téléphone n'en montre plus qu'une bande. -->
    <div class="rotation">
      <svg class="rotation-icone" viewBox="0 0 64 64" fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="23" y="12" width="18" height="30" rx="3" />
        <path d="M32 46v0" />
        <path d="M14 34a18 18 0 0 0 10 16" />
        <path d="M20 46l4 4-4 4" />
        <path d="M50 34a18 18 0 0 1-10 16" />
        <path d="M44 46l-4 4 4 4" />
      </svg>
      <p class="rotation-titre">{locale === "fr" ? "Tourne ton appareil" : "Rotate your device"}</p>
      <p class="rotation-texte">{locale === "fr" ? "Ce site se lit à la verticale." : "This site reads in portrait."}</p>
    </div>

    <div id="scroll-progress" aria-hidden="true">
      <span class="rail"><span class="tick"></span></span>
      <span class="pct">000%</span>
    </div>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
