---
import "../styles/global.css";
import { identity } from "../data/cv";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL;
// Builds an internal URL prefixed with the base (e.g. '/julien-chapron/projets').
const url = (path: string) =>
  path === "/" ? (base === "/" ? "/" : base + "/") : base === "/" ? path : base + path;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Julien Chapron" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- Marks JS as active for scroll reveals: without JS, everything stays visible. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <!-- Rappel d'orientation : affiché uniquement sur écran tactile tenu à
         l'horizontale. Le site est construit sur des blocs d'un écran de
         haut ; couché, un téléphone n'en montre plus qu'une bande. -->
    <div class="rotation">
      <svg class="rotation-icone" viewBox="0 0 64 64" fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="23" y="12" width="18" height="30" rx="3" />
        <path d="M32 46v0" />
        <path d="M14 34a18 18 0 0 0 10 16" />
        <path d="M20 46l4 4-4 4" />
        <path d="M50 34a18 18 0 0 1-10 16" />
        <path d="M44 46l-4 4 4 4" />
      </svg>
      <p class="rotation-titre">Tourne ton appareil</p>
      <p class="rotation-texte">Ce site se lit à la verticale.</p>
    </div>

    <div id="scroll-progress" aria-hidden="true">
      <span class="rail"><span class="tick"></span></span>
      <span class="pct">000%</span>
    </div>

    <header class="site-header">
      <div class="inner">
        <a class="site-name" href={url("/")}>
          <span class="nav-text-col">
            <span class="nav-text-row">Home</span>
            <span class="nav-text-row" aria-hidden="true">Home</span>
          </span>
        </a>
        <a class="axiom-btn axiom-btn-nav" href={`mailto:${identity.email}`}>
          <span class="axiom-btn-text-col">
            <span class="axiom-btn-text-row">Contactez-moi</span>
            <span class="axiom-btn-text-row" aria-hidden="true">Contactez-moi</span>
          </span>
          <span class="axiom-btn-arrow-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h17.4" /><path d="m15.2 6.8 5.2 5.2-5.2 5.2" /></svg>
          </span>
        </a>
        <button class="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </button>
      </div>
    </header>

    <div class="menu-voile" aria-hidden="true">
      <nav class="menu" aria-label="Navigation principale">
        <a class="menu-lien" href={url("/")}>Accueil</a>
        <a class="axiom-btn" href={`mailto:${identity.email}`}>
          <span class="axiom-btn-text-col">
            <span class="axiom-btn-text-row">Contactez-moi</span>
            <span class="axiom-btn-text-row" aria-hidden="true">Contactez-moi</span>
          </span>
          <span class="axiom-btn-arrow-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h17.4" /><path d="m15.2 6.8 5.2 5.2-5.2 5.2" /></svg>
          </span>
        </a>
      </nav>
    </div>

    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
